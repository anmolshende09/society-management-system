# Society ERP SaaS — Environment Configuration Template
NODE_ENV=development
APP_ENV=local
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001
LOG_LEVEL=debug

# Runtime database uses PgBouncer (transaction pooling).
# Migration jobs connect directly to PostgreSQL as app_migrator.
DATABASE_URL=postgresql://app_runtime:LOCAL_DEV_PASSWORD@127.0.0.1:56432/society_erp
MIGRATION_DATABASE_URL=postgresql://app_migrator:LOCAL_MIGRATOR_PASSWORD@127.0.0.1:55432/society_erp
DATABASE_POOL_MAX=10

# Redis & BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Object Storage (S3-compatible, MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=society-erp-local
OBJECT_STORAGE_ACCESS_KEY=LOCAL_MINIO_USER
OBJECT_STORAGE_SECRET_KEY=LOCAL_MINIO_PASSWORD

# Identity and Auth (OAuth 2.0 / JWT)
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=society-erp-web
AUTH_PRIVATE_KEY_FILE=./.secrets/dev-signing-key.pem
AUTH_PUBLIC_KEY_FILE=./.secrets/dev-signing-public.pem
SESSION_COOKIE_NAME=__Host-society_session

# Notifications (Local Mailpit SMTP)
MAIL_HOST=127.0.0.1
MAIL_PORT=51025
MAIL_FROM=no-reply@society-erp.local

# Telemetry and Observability (Optional for local)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Provider Adapters (Strictly mock/sandbox in non-production)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
